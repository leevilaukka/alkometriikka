{
	"name": "alkometriikka",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"dev": "VERBOSE=1 bun run sync --dev && vite dev --host",
		"dev:no-sync": "vite dev --host",
		"build": "vite build && bun run prerender:products",
		"prerender:products": "bun run scripts/prerender-products.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"migrate": "bun run scripts/setup/migrate.ts",
		"sync": "bun run scripts/setup/index.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.5",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^7.3.6"
	},
	"dependencies": {
		"@humanspeak/svelte-virtual-list": "^0.5.14",
		"barcode-detector": "^3.2.2",
		"chart.js": "^4.5.1",
		"class-variance-authority": "^0.7.1",
		"lz-string": "^1.5.0",
		"tailwind-merge": "^3.6.0"
	}
}