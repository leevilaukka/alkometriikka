# Cloudflare R2 (S3-compatible API) — required to upload prerendered OG images
# (scripts/og-images.ts --upload / render-and-upload mode)
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_ACCOUNT_ID=
# Optional overrides:
# CF_R2_BUCKET=alkometriikka-og
# CF_R2_REGION=eu   (R2 jurisdiction; must match the bucket's data location)
# OG_CDN_BASE=https://cdn.alkometriikka.fi
# OG_CONCURRENCY=16